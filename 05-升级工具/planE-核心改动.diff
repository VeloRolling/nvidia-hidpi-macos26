+/* NMRDIAG: temporary runtime switch (sysctl debug.nvkms_allow_headsurface) so the
+ * HiDPI experiment can compare stock behaviour with headSurface allowed in one boot.
+ * Written by kexts/NVRM/os-nvkms-xnu.cpp.
+ * 0 = stock.
+ * 1 = headSurface experiment: request allowHeadSurfaceInNvKms and express the
+ *     scaled desktop as the head viewport (layer stays scaled -> fails at
+ *     commit=0 validation; kept for reference).
+ * 2 = plan E (viewport scaling): the main layer flips 1:1 at the desktop size
+ *     into a head viewport of the same size; the postcomp head scaler scales
+ *     viewPortIn -> raster. No window scaler, no headSurface.
+ * Default is 2: plan E was verified on hardware (4992x2808 -> 3840x2160 test +
+ * COMMIT both pass, mode holds) and only affects requests with src != dst;
+ * 1:1 modes take the stock path byte for byte. sysctl can still force 0/1. */
+int gNvkmsAllowHeadSurfaceOverride = 2;
 
+
 #include "nv_smg.h"
 
 #include <class/cl0000.h> /* NV01_ROOT/NV01_NULL_OBJECT */
@@ -3052,6 +3068,20 @@
                 params->layer[NVKMS_MAIN_LAYER].sizeOut.val.width = layerConfig->dstWidth;
                 params->layer[NVKMS_MAIN_LAYER].sizeOut.val.height = layerConfig->dstHeight;
                 params->layer[NVKMS_MAIN_LAYER].sizeOut.specified = TRUE;
+
+                /*
+                 * NMRDIAG plan E (mode 2): never ask the layer to scale.
+                 * A scaled desktop flips 1:1 at the desktop size; the matching
+                 * viewPortSizeIn override below makes the postcomp head scaler
+                 * do viewPortIn -> raster. Covers modesets and later flips,
+                 * so a flip cannot silently reintroduce layer scaling.
+                 */
+                if (gNvkmsAllowHeadSurfaceOverride == 2 &&
+                    (layerConfig->srcWidth != layerConfig->dstWidth ||
+                     layerConfig->srcHeight != layerConfig->dstHeight)) {
+                    params->layer[NVKMS_MAIN_LAYER].sizeOut.val.width = layerConfig->srcWidth;
+                    params->layer[NVKMS_MAIN_LAYER].sizeOut.val.height = layerConfig->srcHeight;
+                }
             }
